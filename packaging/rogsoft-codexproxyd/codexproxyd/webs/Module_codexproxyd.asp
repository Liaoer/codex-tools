function finishActionWithError(msg){resetActionLogPolling();clearActionCloseTimer();updateLoadingMessage(msg||"操作失败");closeLoadingBarSoon(1500,function(){hideSSLoadingBar();get_dbus_data();get_run_status();refresh_runtime_log();refreshAuditLog();refreshErrorLog();});}
