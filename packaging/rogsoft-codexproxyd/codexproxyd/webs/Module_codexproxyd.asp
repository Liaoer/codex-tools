<table width="100%" border="1" align="center" cellpadding="4" cellspacing="0" bordercolor="#6b8fa3" class="FormTable"><thead><tr><td colspan="2">Error Log</td></tr></thead><tr><th>Recent Errors</th><td><textarea id="error_log" class="ks_runtime_log" readonly="readonly" spellcheck="false"></textarea></td></tr><tr><th>Actions</th><td><input class="button_gen" type="button" value="Refresh Error Log" onclick="refreshErrorLog();" /></td></tr></table>
