function render_status(r){var t=[],kind="info",badge="检测中",cleanupButton=E("cleanup_conflict_button");if(r.processConflict){t.push(r.processConflictText||"检测到多个 codex-tools-proxyd 进程");kind="error";badge="异常";}else if(!r.dockrootInstalled){t.push("DockRoot 未检测到");kind="error";badge="异常";}else if(!r.containerExists){t.push("容器未创建");kind="warn";badge="未创建";}else if(!r.running){t.push("容器已创建但未运行");kind="warn";badge="未运行";}else{t.push("运行中");kind="success";badge="运行中";}if(r.dockrootInstalled&&r.dockrootVersion){t.push(r.dockrootVersion);}if(r.pid){t.push("PID: "+r.pid);}if(r.proxydPidCount&&r.proxydPidCount>1){t.push("Host PIDs: "+r.proxydPidCount);}if(cleanupButton){cleanupButton.style.display=shouldShowCleanupConflictButton(r)?"":"none";}setStatusBadge(kind,badge);E("status").innerHTML=t.join(" | ");renderImageStatus(r);E("local_base_url").innerHTML=r.localBaseUrl||"-";E("lan_base_url").innerHTML=r.lanBaseUrl||"-";E("data_dir").innerHTML=r.dataDir||E("data_dir").innerHTML;E("runtime_log_path").innerHTML=r.logPath||E("runtime_log_path").innerHTML;E("audit_log_path").innerHTML=r.auditLogPath||E("audit_log_path").innerHTML;E("error_log_path").innerHTML=r.errorLogPath||E("error_log_path").innerHTML;E("dockroot_bin").innerHTML=r.dockrootBin||E("dockroot_bin").innerHTML;E("accounts_present").innerHTML=r.accountsPresent?"已存在":"未导入";maybeUpdateApiKeyInput(r.apiKey||"");E("last_error").innerHTML=r.lastError||"无";E("last_import_at").innerHTML=formatLastImportText(r);E("codexproxyd_image_ref").value=r.imageRef||db_codexproxyd["codexproxyd_image_ref"]||E("codexproxyd_image_ref").value;E("codexproxyd_default_model").value="gpt-5.4";ensureSelectValue("codexproxyd_default_effort",r.defaultEffort||db_codexproxyd["codexproxyd_default_effort"]||E("codexproxyd_default_effort").value||"high");ensureSelectValue("codexproxyd_audit_log_level",r.auditLogLevel||db_codexproxyd["codexproxyd_audit_log_level"]||E("codexproxyd_audit_log_level").value||"basic");renderAccountsUsage(r.accountsUsage||[]);scheduleRuntimeLogRefresh(r.running?8e3:0);}
