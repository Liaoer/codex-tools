function renderAccountsUsage(accounts){var list=$.isArray(accounts)?accounts:[],summary=E("accounts_usage_summary"),panel=E("accounts_usage_panel");if(!summary||!panel){return;}if(!list.length){summary.innerHTML="暂无账号额度数据";panel.innerHTML='<div class="ks_usage_empty">暂无账号额度数据。先导入账号，然后点击“一键刷新额度”。</div>';return;}var rows=[];for(var i=0;i<list.length;i++){var item=list[i]||{},email=item.email||"--",plan=item.planType||"--",statusHtml=item.usageError?'<span class="ks_usage_error">'+escapeHtml(item.usageError)+'</span>':'<span class="ks_usage_hint">'+((item.fiveHourUsedPercent===null||typeof item.fiveHourUsedPercent=="undefined")&&(item.oneWeekUsedPercent===null||typeof item.oneWeekUsedPercent=="undefined")?"待刷新":"已刷新")+"</span>";rows.push("<tr><td class=\"ks_usage_index\">"+(i+1)+"</td><td class=\"ks_usage_account\"><span class=\"ks_usage_email\">"+escapeHtml(email)+"</span><span class=\"ks_usage_planline\"><span class=\"ks_plan_badge\">"+escapeHtml(plan)+"</span></span></td><td>"+formatUsageCell(item.fiveHourUsedPercent,item.fiveHourResetAt)+"</td><td>"+formatUsageCell(item.oneWeekUsedPercent,item.oneWeekResetAt)+"</td><td class=\"ks_usage_status\">"+statusHtml+"</td></tr>");}summary.innerHTML="共 "+list.length+" 个账号";panel.innerHTML='<div class="ks_usage_panel_shell"><table class="ks_usage_table"><thead><tr><th class="ks_usage_index">#</th><th>账号</th><th>5h 已用</th><th>1周 已用</th><th class="ks_usage_status">状态</th></tr></thead><tbody>'+rows.join("")+"</tbody></table></div>";}
