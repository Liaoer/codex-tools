function attachChunkedField(fields,key,value){var text=String(value||""),chunkSize=3000,chunks=[],index=0,suffix="";fields[key]="";fields[key+"_chunks"]="0";if(!text){return;}if(text.length<=chunkSize){fields[key]=text;return;}for(index=0;index<text.length;index+=chunkSize){chunks.push(text.substring(index,index+chunkSize));}fields[key+"_chunks"]=String(chunks.length);for(index=0;index<chunks.length;index++){suffix=("0000"+index).slice(-4);fields[key+"_"+suffix]=chunks[index];}}
