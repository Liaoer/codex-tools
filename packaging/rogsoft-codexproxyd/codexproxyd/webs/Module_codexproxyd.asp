<style>
#loading_block3{margin:10px auto;width:85%;font-size:12pt;white-space:pre-line}
.ks_info{line-height:24px}
.ks_info code{font-family:Consolas,monospace;background:rgba(0,0,0,.18);padding:2px 6px;border-radius:4px}
textarea.ks_payload,textarea.ks_runtime_log{width:98%;background:rgba(0,0,0,.2);color:#fff;border:1px solid rgba(255,255,255,.2);padding:10px;font-family:Consolas,monospace;resize:vertical}
textarea.ks_payload{min-height:180px}
textarea.ks_runtime_log{min-height:220px}
input.readonly_field{width:320px!important}
input[type=button]:focus{outline:none}
.ks_badge{display:inline-block;min-width:72px;padding:2px 10px;margin-right:8px;border-radius:999px;font-size:12px;font-weight:bold;text-align:center;color:#fff}
.ks_badge_success{background:#2e8b57}
.ks_badge_warn{background:#d08a00}
.ks_badge_error{background:#b94a48}
.ks_badge_info{background:#5b7fa3}
.ks_status_detail{display:inline-block;vertical-align:middle}
.ks_inline_row,.ks_usage_actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ks_inline_row .button_gen{min-width:60px}
.ks_usage_meta{color:rgba(255,255,255,.75);font-size:12px}
.ks_usage_meta_secondary{display:block;margin-top:4px;color:rgba(255,255,255,.58);font-size:12px}
.ks_usage_empty{padding:4px 0;color:rgba(255,255,255,.75)}
.ks_usage_panel_shell{max-height:420px;overflow:auto;border:1px solid rgba(255,255,255,.08);border-radius:6px;background:rgba(0,0,0,.08)}
.ks_usage_table{width:100%;border-collapse:collapse;table-layout:fixed}
.ks_usage_table th,.ks_usage_table td{padding:10px;border-bottom:1px solid rgba(255,255,255,.08);vertical-align:top}
.ks_usage_table th{text-align:left;position:sticky;top:0;background:rgba(61,78,85,.96);z-index:1}
.ks_usage_table tbody tr:last-child td{border-bottom:none}
.ks_usage_index{width:40px;color:rgba(255,255,255,.65);text-align:center}
.ks_usage_account{min-width:260px}
.ks_usage_email{display:block;font-family:Consolas,monospace;word-break:break-all}
.ks_usage_planline{display:block;margin-top:6px}
.ks_plan_badge{display:inline-block;min-width:56px;padding:2px 8px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:rgba(91,127,163,.35);font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:.04em}
.ks_usage_value{display:block;white-space:nowrap;font-weight:bold}
.ks_usage_reset{display:block;margin-top:2px;color:rgba(255,255,255,.7);font-size:12px}
.ks_usage_status{width:180px}
.ks_usage_hint{display:block;color:rgba(255,255,255,.6);font-size:12px}
.ks_usage_error{display:block;margin-top:4px;color:#ffb4b4;font-size:12px}
#dashboard_shell{display:flex;flex-direction:column;gap:16px;margin-top:12px}
#status_hero{display:grid;grid-template-columns:1.3fr .8fr .9fr;gap:12px}
#summary_cards{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
#compact_config_card,#primary_action_card,.ks_dashboard_card,.ks_advanced_group{border:1px solid rgba(255,255,255,.12);border-radius:8px;background:rgba(0,0,0,.12);padding:14px}
.ks_dashboard_card h4,.ks_advanced_group h4,.ks_primary_title,.ks_section_title{margin:0 0 8px 0;color:#fff;font-size:15px}
.ks_primary_title{font-size:18px}
.ks_primary_hint,.ks_summary_hint,.ks_compact_hint{color:rgba(255,255,255,.72);line-height:1.6}
.ks_summary_value{font-size:14px;font-weight:bold;line-height:1.8;word-break:break-all}
.ks_summary_value code{font-family:Consolas,monospace;background:rgba(0,0,0,.18);padding:2px 6px;border-radius:4px}
.ks_status_meta{margin-top:8px;color:rgba(255,255,255,.72);line-height:1.7}
.ks_primary_button{min-width:140px!important;height:40px}
#config_primary_actions,#config_secondary_actions,.ks_secondary_actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.ks_config_grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 16px}
.ks_field_label{display:block;margin-bottom:4px;color:rgba(255,255,255,.72);font-size:12px}
.ks_compact_block{margin-top:10px}
#danger_actions_panel{border:1px solid rgba(255,180,180,.18);border-radius:8px;background:rgba(80,12,12,.18);padding:14px}
.ks_danger_summary{color:rgba(255,226,226,.86);line-height:1.7}
.ks_button_danger{border-color:rgba(255,180,180,.28)!important;background:rgba(90,20,20,.35)!important}
.ks_button_danger:hover{background:rgba(118,30,30,.42)!important}
#advanced_sections{display:flex;flex-direction:column;gap:10px}
.ks_advanced_toggle{width:100%;display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid rgba(255,255,255,.1);border-radius:8px;background:rgba(0,0,0,.08);color:#fff;cursor:pointer;box-sizing:border-box}
.ks_advanced_toggle .ks_toggle_hint{color:rgba(255,255,255,.56);font-size:12px}
.ks_advanced_panel{display:none;margin-top:8px}
.ks_advanced_panel.ks_open{display:block}
.ks_panel_split{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ks_path_grid{display:grid;grid-template-columns:1fr;gap:10px}
.ks_usage_summary_strip{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.ks_usage_summary_chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:rgba(91,127,163,.22);border:1px solid rgba(255,255,255,.08);font-size:12px;color:#fff}
.ks_usage_summary_chip_warn{background:rgba(208,138,0,.22);border-color:rgba(208,138,0,.35)}
.ks_usage_summary_chip_error{background:rgba(185,74,72,.24);border-color:rgba(185,74,72,.35)}
.ks_usage_hotspot_list{margin-top:10px;color:rgba(255,255,255,.82);line-height:1.8}
.ks_usage_hotspot_item{display:block}
.ks_usage_row_warn td{background:rgba(208,138,0,.08)}
.ks_usage_row_error td{background:rgba(185,74,72,.10)}
#action_phase_banner,#recovery_banner{display:none;border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:12px 14px;background:rgba(0,0,0,.12);line-height:1.7}
#action_phase_banner.ks_phase_running{display:block;border-color:rgba(208,138,0,.32);background:rgba(208,138,0,.12)}
#action_phase_banner.ks_phase_success{display:block;border-color:rgba(46,139,87,.32);background:rgba(46,139,87,.12)}
#action_phase_banner.ks_phase_error{display:block;border-color:rgba(185,74,72,.36);background:rgba(185,74,72,.14)}
#recovery_banner.ks_banner_visible{display:block}
.ks_usage_controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.ks_usage_controls .input_option{min-width:150px}
.ks_usage_filter_hint{color:rgba(255,255,255,.62);font-size:12px}
#audit_summary_card .ks_summary_value{display:flex;flex-direction:column;gap:6px}
.ks_diag_toggle_row{display:flex;justify-content:flex-end;margin:8px 0}
#diagnostic_raw_panel{display:none}
#diagnostic_raw_panel.ks_open{display:block}
#api_key_summary,#accounts_usage_compact_summary,#primary_action_label,#primary_action_hint{display:block}
@media (max-width: 1200px){
  #status_hero,#summary_cards,.ks_panel_split,.ks_config_grid{grid-template-columns:1fr}
}
</style>
<script>
var db_codexproxyd={},status_cache={},status_poll_timer=null,runtime_log_timer=null,status_request_inflight=false,log_request_inflight={},action_close_timer=null,current_action_name="",current_action_request_id="",current_action_success_message="",current_action_usage_summary_updated_at=0,current_action_started_at=0,pending_api_key_value="",last_action_submit_raw="",last_status_raw_json="",last_status_received_at="",audit_log_cache="",error_log_cache="";
function init(){show_menu(menu_hook);set_skin();mountDashboardLayout();bindVisibilityEvents();renderDiagnostics();get_dbus_data(function(){get_disks();get_run_status();refresh_runtime_log();refreshAuditLog();refreshErrorLog();});}
function mountDashboardLayout(){var root=E("FormTitle"),markup="";if(!root){return;}markup=`<tr><td bgcolor="#4D595D" colspan="3" valign="top" style="border-radius:8px">
<div>&nbsp;</div>
<div class="formfonttitle">软件中心 - codexproxyd</div>
<div style="float:right;width:15px;height:25px;margin-top:-20px"><img id="return_btn" onclick="reload_Soft_Center();" align="right" style="cursor:pointer;position:absolute;margin-left:-30px;margin-top:-25px;" title="返回软件中心" src="/images/backprev.png" onMouseOver="this.src='/images/backprevclick.png'" onMouseOut="this.src='/images/backprev.png'"></img></div>
<div style="margin:30px 0 10px 5px;" class="splitLine"></div>
<div class="SimpleNote"><li>这个插件管理运行在 DockRoot 中的 codex-tools-proxyd 容器。</li><li>请先安装 DockRoot，并准备一个 ext4 U 盘或硬盘作为容器和数据存储。</li></div>
<div id="dashboard_shell">
<div id="status_hero">
<div class="ks_dashboard_card"><h4>运行状态</h4><div><span id="status_badge" class="ks_badge ks_badge_info">检测中</span><span id="status" class="ks_status_detail">获取中...</span></div><div id="status_microcopy" class="ks_status_meta">先看状态，再决定下一步。</div></div>
<div class="ks_dashboard_card"><h4>镜像状态</h4><div id="image_status"><span class="ks_badge ks_badge_info">检测中</span></div><div id="image_microcopy" class="ks_status_meta">重点看是否可直接启动。</div></div>
<div class="ks_dashboard_card"><h4>恢复建议</h4><div id="recovery_hint" class="ks_primary_hint">-</div><div id="dashboard_guidance" class="ks_status_meta">常用信息和操作都在首屏。</div></div>
</div>
<div id="action_phase_banner"></div>
<div id="recovery_banner"></div>
<div id="summary_cards">
<div class="ks_dashboard_card"><h4>访问地址</h4><div class="ks_summary_value"><div class="ks_inline_row"><span id="local_base_url">-</span><input class="button_gen" style="width:60px" type="button" value="复制" onclick="copyLocalUrl();" /></div><div class="ks_inline_row"><span id="lan_base_url">-</span><input class="button_gen" style="width:60px" type="button" value="复制" onclick="copyLanUrl();" /></div></div><div class="ks_summary_hint">本机和局域网地址都集中在这里。</div></div>
<div class="ks_dashboard_card"><h4>API Key</h4><div id="api_key_summary" class="ks_summary_value">未设置</div><div class="ks_summary_hint">首屏只展示摘要，编辑请展开“账号与密钥”。</div><div class="ks_secondary_actions"><input id="api_key_quick_copy_button" class="button_gen" style="width:60px" type="button" value="复制" onclick="copyFromElement('api_key_input');" /><input class="button_gen" style="width:88px" type="button" value="去编辑" onclick="toggleAdvancedSection('account',true);" /></div></div>
<div class="ks_dashboard_card"><h4>账号摘要</h4><div class="ks_summary_value"><span id="accounts_present">-</span></div><div id="accounts_usage_compact_summary" class="ks_summary_hint">暂无额度摘要</div><div class="ks_status_meta">最近导入：<span id="last_import_at">-</span><br />最近错误：<span id="last_error">-</span></div></div>
<div id="audit_summary_card" class="ks_dashboard_card"><h4>审计摘要</h4><div class="ks_summary_value"><span id="audit_requests_summary">暂无请求摘要</span><span id="audit_errors_summary">暂无错误摘要</span></div><div class="ks_summary_hint">首屏先看近况，详细日志放在高级区。</div></div>
</div>
<div class="ks_panel_split">
<div id="primary_action_card" class="ks_dashboard_card"><h4 class="ks_primary_title">推荐下一步</h4><span id="primary_action_label" class="ks_summary_value">保存设置</span><span id="primary_action_hint" class="ks_primary_hint">先确认磁盘、镜像和默认参数，再继续。</span><div class="ks_compact_block"><input id="primary_action_button" class="button_gen ks_primary_button" type="button" value="继续" onclick="runPrimaryAction();" /></div><div class="ks_secondary_actions"><input class="button_gen" type="button" value="刷新 Key" onclick="onAction('regenerate_key');" /><input class="button_gen" type="button" value="查看日志" onclick="toggleAdvancedSection('logs',true);" /></div></div>
<div id="compact_config_card" class="ks_dashboard_card"><h4>快速配置</h4><div class="ks_config_grid"><div><label class="ks_field_label" for="codexproxyd_enable">开机自启</label><div style="display:table-cell;float:left;"><label for="codexproxyd_enable"><input id="codexproxyd_enable" class="switch" type="checkbox" style="display:none;"><div class="switch_container"><div class="switch_bar"></div><div class="switch_circle transition_style"><div></div></div></div></label></div></div><div><label class="ks_field_label" for="codexproxyd_disk_path_selected">磁盘挂载点</label><select name="codexproxyd_disk_path_selected" id="codexproxyd_disk_path_selected" class="input_option" onchange="refresh_paths();"></select></div><div><label class="ks_field_label" for="codexproxyd_image_ref">镜像地址</label><input id="codexproxyd_image_ref" type="text" class="input_ss_table" style="width:96%;" value="" placeholder="例如: ghcr.io/example/codex-tools-proxyd:latest" /></div><div><label class="ks_field_label" for="codexproxyd_default_model">Default Model</label><select id="codexproxyd_default_model" class="input_option"><option value="gpt-5-4" selected="selected">gpt-5-4</option></select></div><div><label class="ks_field_label" for="codexproxyd_default_effort">Default Effort</label><select id="codexproxyd_default_effort" class="input_option"><option value="low">low</option><option value="medium">medium</option><option value="high" selected="selected">high</option><option value="xhigh">xhigh</option></select></div><div><label class="ks_field_label" for="codexproxyd_audit_log_level">Audit Log Level</label><select id="codexproxyd_audit_log_level" class="input_option"><option value="off">off</option><option value="basic" selected="selected">basic</option><option value="debug">debug</option></select></div></div><div id="config_primary_actions"><input class="button_gen" type="button" value="保存设置" onclick="onSaveSettings();" /><input class="button_gen" type="button" value="拉取镜像" onclick="onAction('pull_image');" /><input class="button_gen" type="button" value="启动" onclick="onAction('start');" /></div><div id="config_secondary_actions"><input class="button_gen" type="button" value="停止" onclick="onAction('stop');" /><input class="button_gen" type="button" value="重启" onclick="onAction('restart');" /></div></div>
</div>
<div id="danger_actions_panel" class="ks_dashboard_card"><h4>危险操作</h4><div id="danger_action_summary" class="ks_danger_summary">只有在需要清理冲突或重建容器时，再使用这些操作。</div><div class="ks_secondary_actions"><input id="cleanup_conflict_button" class="button_gen ks_button_danger" type="button" value="清理宿主机冲突" onclick="onAction('cleanup_conflict');" style="display:none;" /><input id="remove_container_button" class="button_gen ks_button_danger" type="button" value="删除容器" onclick="onAction('remove_container');" /></div></div>
<div id="advanced_sections">
<div id="account_details_panel" class="ks_advanced_group" data-panel="account"><button type="button" id="advanced_toggle_account" class="ks_advanced_toggle" data-panel="account" data-open="0" onclick="toggleAdvancedSection('account');"><span>账号与密钥</span><span class="ks_toggle_hint">导入 accounts.json / auth.json，或编辑 API Key</span></button><div id="advanced_account_panel" class="ks_advanced_panel"><div class="ks_panel_split"><div><label class="ks_field_label" for="codexproxyd_payload_kind">导入模式</label><select id="codexproxyd_payload_kind" class="input_option"><option value="accounts_json">accounts.json</option><option value="auth_json">auth.json</option></select><div class="ks_compact_block"><label class="ks_field_label" for="codexproxyd_payload_text">粘贴内容</label><textarea id="codexproxyd_payload_text" class="ks_payload" spellcheck="false" placeholder="在这里粘贴 accounts.json 或完整 auth.json"></textarea></div><div class="ks_secondary_actions"><input class="button_gen" type="button" value="导入 accounts.json" onclick="onAction('import_accounts');" /><input class="button_gen" type="button" value="导入 auth.json" onclick="onAction('import_auth');" /></div></div><div id="api_key_editor_panel"><h4>API Key 编辑</h4><div id="api_key_editor_hint" class="ks_summary_hint">这里保存的是代理真实使用的 key。保存后会沿用现有逻辑自动生效或提示重启。</div><div class="ks_compact_block"><input id="api_key_input" class="input_ss_table" type="password" value="" placeholder="留空则保持当前 key 不变" /></div><div class="ks_secondary_actions"><input class="button_gen" style="width:90px" type="button" value="显示/隐藏" onclick="toggleApiKey();" /><input class="button_gen" style="width:60px" type="button" value="复制" onclick="copyFromElement('api_key_input');" /></div><div class="ks_compact_block"><h4>导入说明</h4><div class="ks_info"><li>选择 <code>accounts.json</code> 时会直接校验并写入数据目录。</li><li>选择 <code>auth.json</code> 时，页面会先转换成单账号 <code>accounts.json</code>，再提交保存。</li></div></div></div></div></div>
<div id="usage_details_panel" class="ks_advanced_group" data-panel="usage"><button type="button" id="advanced_toggle_usage" class="ks_advanced_toggle" data-panel="usage" data-open="0" onclick="toggleAdvancedSection('usage');"><span>账号额度</span><span class="ks_toggle_hint">先看摘要，需要时再展开完整列表</span></button><div id="advanced_usage_panel" class="ks_advanced_panel"><div class="ks_usage_actions"><input class="button_gen" type="button" value="一键刷新额度" onclick="onAction('refresh_usage');" /><span id="accounts_usage_summary" class="ks_usage_meta">暂无账号额度数据</span></div><div class="ks_usage_controls"><select id="accounts_usage_filter" class="input_option" onchange="renderAccountsUsage(parseAccountsUsage(status_cache.accountsUsage));"><option value="all">全部账号</option><option value="attention">只看需关注</option><option value="errors">只看异常</option></select><select id="accounts_usage_sort" class="input_option" onchange="renderAccountsUsage(parseAccountsUsage(status_cache.accountsUsage));"><option value="risk_desc">按风险排序</option><option value="email_asc">按账号排序</option></select><span class="ks_usage_filter_hint">先看异常和高占用，再决定是否处理。</span></div><div class="ks_usage_summary_strip"><span id="accounts_usage_issue_summary" class="ks_usage_summary_chip">暂无异常</span><span id="accounts_usage_hotspot_summary" class="ks_usage_summary_chip">暂无高占用</span></div><div class="ks_usage_hotspot_list" id="accounts_usage_hotspot_list">暂无需要优先关注的账号。</div><div class="ks_compact_block" id="accounts_usage_panel">暂无账号额度数据。先导入账号，然后点击“一键刷新额度”。</div></div></div>
